# Aplicación
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# En producción usa la URL pública del frontend; para Tauri usa la URL pública del backend.
VITE_API_URL=
VITE_API_DEBUG=false
SESSION_SECRET=reemplaza_con_un_secreto_largo_y_aleatorio

# PostgreSQL: configura solo una
DATABASE_URL=postgresql://usuario:password@localhost:5432/inventory_app
# POSTGRES_URL=postgresql://usuario:password@localhost:5432/inventory_app

# Inicialización única de una base vacía
DATABASE_BOOTSTRAP_CONFIRM=inventory_app
BOOTSTRAP_SUPER_ADMIN_USERNAME=admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=reemplaza_con_una_password_segura

# Operaciones manuales de migración
MIGRATION_UP_CONFIRM=inventory_app
MIGRATION_BASELINE_CONFIRM=inventory_app

# false para PostgreSQL local/Dokploy; true si el proveedor exige SSL
DATABASE_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> | Boxing Inventory</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <%
    const isEditing = Boolean(category.id);

    const formAction = isEditing
      ? `/categories/${category.id}/edit`
      : "/categories/new";

    const cancelUrl = isEditing
      ? `/categories/${category.id}`
      : "/categories";
  %>

  <header class="main-header">
    <div class="container header-content">
      <a href="/" class="logo">Boxing Inventory</a>

      <nav aria-label="Navegación principal">
        <a href="/">Inicio</a>
        <a href="/categories">Categorías</a>
        <a href="/items">Productos</a>
        <span class="current-user"><%= currentBusiness.name %></span>
        <a href="/businesses/select">Cambiar negocio</a>
      </nav>
    </div>
  </header>

  <main class="container form-page">
    <a href="<%= cancelUrl %>" class="back-link">
      ← Regresar
    </a>

    <section class="form-container">
      <div>
        <p class="eyebrow">
          <%= isEditing
            ? "Actualizar categoría"
            : "Nueva categoría" %>
        </p>

        <h1>
          <%= isEditing
            ? "Editar categoría"
            : "Crear categoría" %>
        </h1>

        <p class="form-description">
          <% if (isEditing) { %>
            Modifica el nombre y la descripción de la categoría.
          <% } else { %>
            Crea una categoría para organizar los productos del inventario.
          <% } %>
        </p>
      </div>

      <% if (errors.length > 0) { %>
        <div class="error-summary" role="alert">
          <strong>
            No se pudo
            <%= isEditing ? "actualizar" : "guardar" %>
            la categoría:
          </strong>

          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form
        action="<%= formAction %>"
        method="POST"
        class="inventory-form"
      >
        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >
        <div class="form-group">
          <label for="name">Nombre</label>

          <input
            type="text"
            id="name"
            name="name"
            value="<%= category.name %>"
            minlength="2"
            maxlength="50"
            autocomplete="off"
            required
          >
        </div>

        <div class="form-group">
          <label for="description">Descripción</label>

          <textarea
            id="description"
            name="description"
            rows="6"
            maxlength="1000"
          ><%= category.description %></textarea>
        </div>

        <div class="form-actions">
          <a
            href="<%= cancelUrl %>"
            class="button button-secondary"
          >
            Cancelar
          </a>

          <button type="submit" class="button">
            <%= isEditing
              ? "Guardar cambios"
              : "Crear categoría" %>
          </button>
        </div>
      </form>
    </section>
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> | Boxing Inventory</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <header class="main-header">
    <div class="container header-content">
      <a href="/" class="logo">Boxing Inventory</a>

      <nav aria-label="Navegación principal">
        <a href="/">Inicio</a>
        <a href="/categories">Categorías</a>
        <a href="/items">Productos</a>
        <span class="current-user"><%= currentBusiness.name %></span>
        <a href="/businesses/select">Cambiar negocio</a>
      </nav>
    </div>
  </header>

  <main class="container page-content">
    <div class="section-heading">
      <div>
          <p class="eyebrow">Administración</p>
          <h1>Categorías</h1>
          <p>Consulta las categorías del inventario.</p>
        </div>

        <% if (canManageInventory) { %>
          <a href="/categories/new" class="button">
            Crear categoría
          </a>
        <% } %>
    </div>

    <% if (categories.length === 0) { %>
      <p class="empty-message">
        No existen categorías todavía.
      </p>
    <% } else { %>
      <div class="category-grid">
        <% categories.forEach((category) => { %>
          <article class="category-card">
            <h2>
              <a href="/categories/<%= category.id %>">
                <%= category.name %>
              </a>
            </h2>

            <p><%= category.description %></p>

            <div class="card-footer">
              <span class="badge">
                <%= category.item_count %>
                <%= category.item_count === 1 ? "producto" : "productos" %>
              </span>

              <a href="/categories/<%= category.id %>">
                Ver detalles →
              </a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>

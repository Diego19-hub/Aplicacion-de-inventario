<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> | Boxing Inventory</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <header class="main-header">
    <div class="container header-content">
      <a href="/" class="logo">Boxing Inventory</a>

      <nav aria-label="Navegación principal">
        <a href="/">Inicio</a>
        <a href="/categories">Categorías</a>
        <a href="/items">Productos</a>
        <span class="current-user"><%= currentBusiness.name %></span>
        <a href="/businesses/select">Cambiar negocio</a>
      </nav>
    </div>
  </header>

  <main class="container page-content">
    <a href="/categories" class="back-link">
      ← Regresar a categorías
    </a>

  <section class="category-header">
    <div>
      <p class="eyebrow">Categoría</p>
      <h1><%= category.name %></h1>
      <p><%= category.description %></p>
    </div>

    <% if (canManageInventory || canDeleteInventory) { %>
      <div class="actions">
        <% if (canManageInventory) { %>
        <a
          href="/categories/<%= category.id %>/edit"
          class="button button-secondary"
        >
          Editar
        </a>
        <% } %>

        <% if (canDeleteInventory) { %>
        <a
          href="/categories/<%= category.id %>/delete"
          class="button button-danger"
        >
          Eliminar
        </a>
        <% } %>
      </div>
    <% } %>
</section>

    <section aria-labelledby="products-title">
      <div class="section-heading">
        <div>
          <h2 id="products-title">Productos</h2>

          <p>
            <%= category.item_count %>
            <%= category.item_count === 1
              ? "producto en esta categoría"
              : "productos en esta categoría" %>
          </p>
        </div>

        <% if (canManageInventory) { %>
          <a
            href="/items/new?category=<%= category.id %>"
            class="button"
          >
            Agregar producto
          </a>
        <% } %>
      </div>

      <% if (items.length === 0) { %>
        <p class="empty-message">
          Esta categoría todavía no contiene productos.
        </p>
      <% } else { %>
        <div class="items-grid">
          <% items.forEach((item) => { %>
            <article class="item-card">
              <div>
                <span class="brand"><%= item.brand %></span>
                <h3>
                  <a href="/items/<%= item.id %>">
                    <%= item.name %>
                  </a>
                </h3>

                <p><%= item.description %></p>
              </div>

              <div class="item-information">
                <strong>
                  <%= Number(item.price).toLocaleString("es-MX", {
                    style: "currency",
                    currency: "MXN"
                  }) %>
                </strong>

                <span
                  class="<%= item.stock === 0 ? 'stock stock-empty' : 'stock' %>"
                >
                  <%= item.stock %> disponibles
                </span>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>

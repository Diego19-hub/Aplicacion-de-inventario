<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <link rel="stylesheet" href="/styles.css">
  <title>Proveedores</title>
</head>
<body>
  <main class="container page-content">
    <h1>Proveedores</h1>

    <% if (canManageInventory) { %>
      <a class="button" href="/suppliers/new">Crear proveedor</a>
    <% } %>

    <form method="get" class="item-filters">
      <div class="form-group">
        <label for="supplier-search">Buscar proveedor</label>
        <input
          id="supplier-search"
          name="q"
          value="<%= q %>"
          placeholder="Buscar proveedor"
        >
      </div>

      <div class="form-group">
        <label for="supplier-status">Estado</label>
        <select id="supplier-status" name="status">
          <% ["active", "inactive", "all"].forEach((optionStatus) => { %>
            <option
              value="<%= optionStatus %>"
              <%= status === optionStatus ? "selected" : "" %>
            >
              <%= optionStatus %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-actions">
        <button class="button">Buscar</button>
        <a class="button button-secondary" href="/suppliers">Limpiar</a>
      </div>
    </form>

    <p><%= count %> proveedores</p>

    <% rows.forEach((supplier) => { %>
      <article class="category-card">
        <h2>
          <a href="/suppliers/<%= supplier.id %>"><%= supplier.name %></a>
        </h2>
        <p><%= supplier.status %></p>
      </article>
    <% }) %>
  </main>
</body>
</html>

<!doctype html><html lang="es"><head><meta charset="utf-8"><link rel="stylesheet" href="/styles.css"><title>Proveedores</title></head><body><main class="container page-content"><h1>Proveedores</h1><%if(canManageInventory){%><a class="button" href="/suppliers/new">Crear proveedor</a><%}%><form method="get" class="item-filters"><input name="q" value="<%=q%>" placeholder="Buscar proveedor"><select name="status"><%['active','inactive','all'].forEach(s=>{%><option value="<%=s%>" <%=status===s?'selected':''%>><%=s%></option><%})%></select><button class="button">Buscar</button></form><p><%=count%> proveedores</p><%rows.forEach(s=>{%><article class="category-card"><h2><a href="/suppliers/<%=s.id%>"><%=s.name%></a></h2><p><%=s.status%></p></article><%})%></main></body></html>

<!doctype html><html lang="es"><head><meta charset="utf-8"><link rel="stylesheet" href="/styles.css"><title><%=supplier.name%></title></head><body><main class="container page-content"><a href="/suppliers">← Proveedores</a><h1><%=supplier.name%></h1><p>Estado: <%=supplier.status%></p><p><%=supplier.email||''%></p><%if(canManageInventory){%><a class="button" href="/suppliers/<%=supplier.id%>/edit">Editar</a><a class="button" href="/suppliers/<%=supplier.id%>/<%=supplier.status==='active'?'deactivate':'reactivate'%>"><%=supplier.status==='active'?'Desactivar':'Reactivar'%></a><%}%></main></body></html>

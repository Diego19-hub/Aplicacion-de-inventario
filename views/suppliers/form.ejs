<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <link rel="stylesheet" href="/styles.css">
  <title><%= title %></title>
</head>
<body>
  <main class="container form-page">
    <a href="/suppliers" class="back-link">← Regresar</a>
    <h1><%= title %></h1>

    <% if (errors.length) { %>
      <div class="error-summary" role="alert">
        <ul><% errors.forEach((error) => { %><li><%= error.msg %></li><% }) %></ul>
      </div>
    <% } %>

    <form class="inventory-form" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% const fields = [['name','Nombre comercial',true],['legalName','Razón social',false],['taxId','RFC o identificación',false],['contactName','Contacto',false],['email','Correo',false],['phone','Teléfono',false],['address','Dirección',false],['notes','Notas',false]]; %>
      <% fields.forEach(([key, label, required]) => { const fieldError = errors.find((error) => error.path === key); %>
        <div class="form-group">
          <label for="<%= key %>"><%= label %><%= required ? '' : ' (opcional)' %></label>
          <input
            id="<%= key %>"
            name="<%= key %>"
            value="<%= supplier[key] %>"
            <%= required ? 'required' : '' %>
            <%= fieldError ? 'aria-invalid="true" aria-describedby="' + key + '-error"' : '' %>
          >
          <% if (fieldError) { %><p id="<%= key %>-error" class="field-error"><%= fieldError.msg %></p><% } %>
        </div>
      <% }) %>
      <button class="button">Guardar</button>
    </form>
  </main>
</body>
</html>

<!doctype html><html lang="es"><head><meta charset="utf-8"><link rel="stylesheet" href="/styles.css"><title><%=title%></title></head><body><main class="container form-page"><a href="/suppliers" class="back-link">← Regresar</a><h1><%=title%></h1><%if(errors.length){%><div class="error-summary"><ul><%errors.forEach(e=>{%><li><%=e.msg%></li><%})%></ul></div><%}%><form class="inventory-form" method="post"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><%for(const [key,label] of [['name','Nombre comercial'],['legalName','Razón social'],['taxId','RFC o identificación'],['contactName','Contacto'],['email','Correo'],['phone','Teléfono'],['address','Dirección'],['notes','Notas']]){%><div class="form-group"><label><%=label%></label><input name="<%=key%>" value="<%=supplier[key]%>" <%=key==='name'?'required':''%>></div><%}%><button class="button">Guardar</button></form></main></body></html>

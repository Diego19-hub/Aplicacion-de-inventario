<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Boxing Inventory</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container form-page">
    <section class="form-container">
      <p class="eyebrow">Cuenta de negocio</p>
      <h1>Selecciona un negocio</h1>
      <p class="form-description">Elige el negocio cuyo inventario deseas administrar.</p>

      <form action="/businesses/select" method="POST" class="inventory-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="businessId">Negocio</label>
          <select id="businessId" name="businessId" required>
            <option value="">Selecciona un negocio</option>
            <% businesses.forEach((business) => { %>
              <option value="<%= business.id %>">
                <%= business.name %> (<%= business.role %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="form-actions">
          <button type="submit" class="button">Continuar</button>
        </div>
      </form>
    </section>
  </main>
</body>
</html>

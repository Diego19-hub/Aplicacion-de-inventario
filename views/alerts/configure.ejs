<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Boxing Inventory</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="main-header">
    <div class="container header-content">
      <a href="/" class="logo">Boxing Inventory</a>
      <nav aria-label="Navegación principal"><a href="/items">Productos</a><a href="/alerts/stock">Alertas</a></nav>
    </div>
  </header>
  <main class="container page-content">
    <a class="back-link" href="/items/<%= item.id %>">← Regresar al producto</a>
    <a class="back-link" href="/alerts/stock">← Alertas de stock</a>
    <section class="page-header">
      <p class="eyebrow"><%= item.sku %></p>
      <h1>Configurar stock mínimo</h1>
      <p><strong><%= item.name %></strong>. Cada ubicación puede tener un mínimo distinto.</p>
    </section>
    <% if (errors.length) { %>
      <section class="error-summary" role="alert" aria-labelledby="errors-title"><h2 id="errors-title">Revisa los datos</h2><ul><% errors.forEach((error) => { %><li><%= error.msg %></li><% }) %></ul></section>
    <% } %>
    <section class="summary-grid">
      <% locations.forEach((location) => {
        const locationId = location.location_id;
        const hasThreshold = location.minimum_stock !== null && location.minimum_stock !== undefined;
        const submitted = String(formData.locationId || "") === String(locationId);
        const minimumStockError = submitted
          ? errors.find((error) => error.path === "minimumStock")
          : null;
        const value = submitted ? formData.minimumStock : hasThreshold ? location.minimum_stock : "";
        const state = !hasThreshold
          ? "Sin configurar"
          : location.alert_status === "out_of_stock"
            ? "Agotado"
            : location.alert_status === "low_stock"
              ? "Stock bajo"
              : "Normal";
      %>
        <article class="summary-card">
          <h2><%= location.location_name %> (<%= location.code %>)</h2>
          <p>Stock actual: <strong><%= location.current_stock %></strong></p>
          <p>Mínimo: <strong><%= hasThreshold ? location.minimum_stock : 'Sin configurar' %></strong></p>
          <p>Estado: <strong><%= state %></strong></p>
          <form method="POST" action="/alerts/products/<%= item.id %>/thresholds" class="inventory-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="locationId" value="<%= locationId %>">
            <label for="minimumStock-<%= locationId %>">Stock mínimo</label>
            <input
              id="minimumStock-<%= locationId %>"
              name="minimumStock"
              type="number"
              min="0"
              max="1000000"
              step="1"
              required
              value="<%= value %>"
              <% if (minimumStockError) { %>
                aria-invalid="true"
                aria-describedby="minimumStock-<%= locationId %>-error"
              <% } %>
            >
            <% if (minimumStockError) { %>
              <p id="minimumStock-<%= locationId %>-error" class="field-error"><%= minimumStockError.msg %></p>
            <% } %>
            <button class="button"><%= hasThreshold ? 'Actualizar mínimo' : 'Guardar mínimo' %></button>
          </form>
          <% if (hasThreshold) { %>
            <form method="POST" action="/alerts/products/<%= item.id %>/thresholds/<%= location.location_id %>/delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button-danger">Eliminar configuración</button>
            </form>
          <% } %>
        </article>
      <% }) %>
    </section>
  </main>
</body>
</html>

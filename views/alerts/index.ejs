<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Boxing Inventory</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="main-header">
    <div class="container header-content">
      <a href="/" class="logo">Boxing Inventory</a>
      <nav aria-label="Navegación principal">
        <a href="/">Inicio</a><a href="/items">Productos</a><a href="/reports">Reportes</a>
      </nav>
    </div>
  </header>
  <main class="container page-content">
    <a href="/reports" class="back-link">← Regresar a reportes</a>
    <section class="page-header"><div><p class="eyebrow">Inventario</p><h1>Alertas de stock</h1></div></section>
    <form method="GET" action="/alerts/stock" class="filters-form">
      <div class="form-group"><label for="q">Buscar</label><input id="q" type="search" name="q" value="<%= filters.q || '' %>"></div>
      <div class="form-group"><label for="category">Categoría</label><select id="category" name="category"><option value="">Todas</option><% categories.forEach((x) => { %><option value="<%= x.id %>" <%= filters.categoryId === x.id ? 'selected' : '' %>><%= x.name %></option><% }) %></select></div>
      <div class="form-group"><label for="location">Ubicación</label><select id="location" name="location"><option value="">Todas</option><% locations.forEach((x) => { %><option value="<%= x.id %>" <%= filters.locationId === x.id ? 'selected' : '' %>><%= x.name %> (<%= x.code %>)</option><% }) %></select></div>
      <div class="form-group"><label for="alertStatus">Estado</label><select id="alertStatus" name="alertStatus"><option value="all" <%= filters.alertStatus === 'all' ? 'selected' : '' %>>Todas</option><option value="out_of_stock" <%= filters.alertStatus === 'out_of_stock' ? 'selected' : '' %>>Agotado</option><option value="low_stock" <%= filters.alertStatus === 'low_stock' ? 'selected' : '' %>>Stock bajo</option></select></div>
      <button class="button">Filtrar</button><a class="button button-secondary" href="/alerts/stock">Limpiar filtros</a>
    </form>
    <p><%= count %> alertas</p>
    <% if (!count) { %><p><%= filters.q || filters.categoryId || filters.locationId || filters.alertStatus !== 'all' ? 'No hay coincidencias con los filtros.' : 'No existen alertas activas.' %></p><% } else { %>
      <div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Producto</th><th>SKU</th><th>Categoría</th><th>Ubicación</th><th>Stock actual</th><th>Mínimo</th><th>Estado</th><% if (canManageThresholds) { %><th>Acción</th><% } %></tr></thead><tbody><% rows.forEach((row) => { %><tr><td><a href="/items/<%= row.item_id %>"><%= row.item_name %></a></td><td><%= row.sku %></td><td><%= row.category_name %></td><td><%= row.location_name %> (<%= row.location_code %>)</td><td><%= row.current_stock %></td><td><%= row.minimum_stock %></td><td><%= row.alert_status === 'out_of_stock' ? 'Agotado' : 'Stock bajo' %></td><% if (canManageThresholds) { %><td><a href="/alerts/products/<%= row.item_id %>/thresholds">Configurar</a></td><% } %></tr><% }) %></tbody></table></div>
    <% } %>
    <% if (pages > 1) { const params = new URLSearchParams(); if (filters.q) params.set('q',filters.q); if (filters.categoryId) params.set('category',filters.categoryId); if (filters.locationId) params.set('location',filters.locationId); if (filters.alertStatus) params.set('alertStatus',filters.alertStatus); const pageUrl=(p)=>{const x=new URLSearchParams(params);x.set('page',p);return '/alerts/stock?'+x.toString();}; const start=Math.max(1,filters.page-2),end=Math.min(pages,filters.page+2); %><nav class="pagination" aria-label="Paginación"><% if(filters.page>1){ %><a href="<%= pageUrl(filters.page-1) %>">Anterior</a><% } %><% for(let p=start;p<=end;p++){ %><a href="<%= pageUrl(p) %>" <%= p===filters.page ? 'aria-current="page"' : '' %>><%= p %></a><% } %><% if(filters.page<pages){ %><a href="<%= pageUrl(filters.page+1) %>">Siguiente</a><% } %></nav><% } %>
  </main>
</body>
</html>

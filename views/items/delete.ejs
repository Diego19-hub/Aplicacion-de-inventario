<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> | Boxing Inventory</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <header class="main-header">
    <div class="container header-content">
      <a href="/" class="logo">Boxing Inventory</a>

      <nav aria-label="Navegación principal">
        <a href="/">Inicio</a>
        <a href="/categories">Categorías</a>
        <a href="/items">Productos</a>
        <span class="current-user"><%= currentBusiness.name %></span>
        <a href="/businesses/select">Cambiar negocio</a>
      </nav>
    </div>
  </header>

  <main class="container form-page">
    <a href="/items/<%= item.id %>" class="back-link">
      ← Regresar al producto
    </a>

    <section class="delete-container">
      <div>
        <p class="eyebrow">Confirmación</p>
        <h1>Archivar producto</h1>

        <p class="form-description">
          Revisa la información antes de confirmar.
        </p>
      </div>

      <article class="delete-card">
        <span class="brand"><%= item.brand %></span>
        <h2><%= item.name %></h2>

        <p><%= item.description %></p>

        <dl class="delete-information">
          <div>
            <dt>SKU</dt>
            <dd><%= item.sku %></dd>
          </div>

          <div>
            <dt>Categoría</dt>
            <dd><%= item.category_name %></dd>
          </div>

          <div>
            <dt>Precio</dt>
            <dd>
              <%= Number(item.price).toLocaleString("es-MX", {
                style: "currency",
                currency: "MXN"
              }) %>
            </dd>
          </div>

          <div>
            <dt>Existencias</dt>
            <dd><%= item.stock %> unidades</dd>
          </div>
        </dl>
      </article>

      <div class="warning-message">
        <strong>El producto dejará de mostrarse en el inventario activo.</strong>

        <p>
          Sus datos y SKU se conservarán; para archivarlo se requiere un motivo.
        </p>
      </div>

      <form
        action="/items/<%= item.id %>/archive"
        method="POST"
        class="form-actions"
      >
        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >
        <a
          href="/items/<%= item.id %>"
          class="button button-secondary"
        >
          Cancelar
        </a>

        <button type="submit" class="button button-danger">Archivar producto</button>
      </form>
    </section>
  </main>
</body>
</html>

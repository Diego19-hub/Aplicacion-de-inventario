<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Boxing Inventory</title><link rel="stylesheet" href="/styles.css"></head>
<body><header class="main-header"><div class="container header-content"><a href="/" class="logo">Boxing Inventory</a><nav aria-label="Navegación principal"><a href="/">Inicio</a><a href="/items">Productos activos</a><span class="current-user"><%= currentBusiness.name %></span></nav></div></header>
<main class="container page-content"><a href="/items" class="back-link">← Regresar a productos activos</a><div class="section-heading"><div><p class="eyebrow">Solo propietario</p><h1>Productos archivados</h1><p>Estos productos conservan su SKU y no aparecen en el inventario activo.</p></div></div>
<% if (items.length === 0) { %><p class="empty-message">No hay productos archivados.</p><% } else { %><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Producto</th><th>SKU</th><th>Categoría</th><th>Archivado</th><th>Por</th><th>Motivo</th><th>Acciones</th></tr></thead><tbody><% items.forEach((item) => { %><tr><td><a href="/items/<%= item.id %>/archived"><%= item.name %></a></td><td><%= item.sku %></td><td><%= item.category_name %></td><td><%= new Date(item.archived_at).toLocaleString("es-MX") %></td><td><%= item.archived_by_username %></td><td><%= item.archive_reason %></td><td><a href="/items/<%= item.id %>/archived" class="button button-secondary">Ver</a> <a href="/items/<%= item.id %>/restore" class="button">Restaurar</a></td></tr><% }) %></tbody></table></div><% } %></main></body></html>

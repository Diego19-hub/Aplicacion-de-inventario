<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body><main class="container page-content"><a href="<%= archived ? '/items/' + item.id + '/archived' : '/items/' + item.id %>" class="back-link">← Regresar al producto</a><div class="section-heading"><div><h1>Movimientos</h1><p><%= item.name %> · Stock total: <%= item.stock %></p></div><% if(!archived && canManageInventory){ %><a class="button" href="/items/<%= item.id %>/movements/new">Registrar movimiento</a><% } %></div><form method="GET"><label for="locationId">Ubicación</label><select id="locationId" name="locationId"><option value="">Todas</option><% locations.forEach(l=>{ %><option value="<%= l.id %>" <%= locationId===l.id?'selected':'' %>><%= l.name %> (<%= l.code %>)</option><% }) %></select><button class="button button-secondary">Filtrar</button></form><p><%= total %> movimientos</p><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Fecha</th><th>Ubicación</th><th>Tipo</th><th>Delta</th><th>Anterior</th><th>Resultado</th><th>Motivo</th><th>Usuario</th></tr></thead><tbody><% movements.forEach(m=>{ %><tr><td><%= new Date(m.created_at).toLocaleString('es-MX') %></td><td><%= m.location_name %> (<%= m.location_code %>)</td><td><%= m.movement_type %></td><td><%= m.quantity_delta > 0 ? '+' : '' %><%= m.quantity_delta %></td><td><%= m.previous_stock %></td><td><%= m.resulting_stock %></td><td><%= m.reason %></td><td><%= m.username %></td></tr><% }) %></tbody></table></div></main></body></html>

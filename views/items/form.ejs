<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> | Boxing Inventory</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <%
    const isEditing = Boolean(item.id);

    const formAction = isEditing
      ? `/items/${item.id}/edit`
      : "/items/new";

    const cancelUrl = isEditing
      ? `/items/${item.id}`
      : "/items";
  %>

  <header class="main-header">
    <div class="container header-content">
      <a href="/" class="logo">Boxing Inventory</a>

      <nav aria-label="Navegación principal">
        <a href="/">Inicio</a>
        <a href="/categories">Categorías</a>
        <a href="/items">Productos</a>
      </nav>
    </div>
  </header>

  <main class="container form-page">
    <a href="<%= cancelUrl %>" class="back-link">
      ← Regresar
    </a>

    <section class="form-container">
      <div>
        <p class="eyebrow">
          <%= isEditing ? "Actualizar producto" : "Nuevo producto" %>
        </p>

        <h1>
          <%= isEditing ? "Editar producto" : "Crear producto" %>
        </h1>

        <p class="form-description">
          <% if (isEditing) { %>
            Modifica la información, precio y existencias del producto.
          <% } else { %>
            Registra un nuevo artículo en el inventario.
          <% } %>
        </p>
      </div>

      <% if (errors.length > 0) { %>
        <div class="error-summary" role="alert">
          <strong>
            No se pudo
            <%= isEditing ? "actualizar" : "guardar" %>
            el producto:
          </strong>

          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <% if (categories.length === 0) { %>
        <div class="warning-message">
          <strong>No existen categorías.</strong>

          <p>
            Debes
            <a href="/categories/new">crear una categoría</a>
            antes de registrar productos.
          </p>
        </div>
      <% } else { %>

        <form
          action="<%= formAction %>"
          method="POST"
          class="inventory-form"
        >
          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >
          <div class="form-group">
            <label for="name">Nombre</label>

            <input
              type="text"
              id="name"
              name="name"
              value="<%= item.name %>"
              minlength="2"
              maxlength="100"
              required
            >
          </div>

          <div class="form-group">
            <label for="brand">Marca</label>

            <input
              type="text"
              id="brand"
              name="brand"
              value="<%= item.brand %>"
              minlength="2"
              maxlength="50"
              required
            >
          </div>

          <div class="form-group">
            <label for="description">Descripción</label>

            <textarea
              id="description"
              name="description"
              rows="6"
              minlength="10"
              maxlength="1000"
              required
            ><%= item.description %></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="price">Precio</label>

              <input
                type="number"
                id="price"
                name="price"
                value="<%= item.price %>"
                min="0"
                max="99999999.99"
                step="0.01"
                inputmode="decimal"
                required
              >
            </div>

            <div class="form-group">
              <label for="stock">Existencias</label>

              <input
                type="number"
                id="stock"
                name="stock"
                value="<%= item.stock %>"
                min="0"
                max="1000000"
                step="1"
                inputmode="numeric"
                required
              >
            </div>
          </div>

          <div class="form-group">
            <label for="categoryId">Categoría</label>

            <select
              id="categoryId"
              name="categoryId"
              required
            >
              <option value="">
                Selecciona una categoría
              </option>

              <% categories.forEach((category) => { %>
                <option
                  value="<%= category.id %>"
                  <%= Number(item.categoryId) === category.id
                    ? "selected"
                    : "" %>
                >
                  <%= category.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-actions">
            <a
              href="<%= cancelUrl %>"
              class="button button-secondary"
            >
              Cancelar
            </a>

            <button type="submit" class="button">
              <%= isEditing
                ? "Guardar cambios"
                : "Crear producto" %>
            </button>
          </div>
        </form>
      <% } %>
    </section>
  </main>
</body>
</html>

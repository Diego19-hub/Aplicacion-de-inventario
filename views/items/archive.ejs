<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Boxing Inventory</title><link rel="stylesheet" href="/styles.css"></head>
<body><header class="main-header"><div class="container header-content"><a href="/" class="logo">Boxing Inventory</a><nav aria-label="Navegación principal"><a href="/">Inicio</a><a href="/items">Productos</a><a href="/items/archived">Productos archivados</a></nav></div></header>
<main class="container form-page"><a href="/items/<%= item.id %>" class="back-link">← Regresar al producto</a><section class="delete-container"><div><p class="eyebrow">Confirmación</p><h1>Archivar producto</h1><p class="form-description">El producto dejará de mostrarse en el inventario activo, pero sus datos y SKU se conservarán.</p></div>
<% if (errors.length > 0) { %><div class="error-summary" role="alert"><strong>No se pudo archivar:</strong><ul><% errors.forEach((error) => { %><li><%= error.msg %></li><% }) %></ul></div><% } %>
<article class="delete-card"><span class="brand"><%= item.brand %></span><h2><%= item.name %></h2><p>SKU: <strong><%= item.sku %></strong></p><p><%= item.description %></p></article>
<form action="/items/<%= item.id %>/archive" method="POST" class="inventory-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-group"><label for="archiveReason">Motivo de archivado</label><textarea id="archiveReason" name="archiveReason" rows="5" minlength="5" maxlength="500" required><%= archiveReason %></textarea><small>Entre 5 y 500 caracteres.</small></div><div class="form-actions"><a href="/items/<%= item.id %>" class="button button-secondary">Cancelar</a><button type="submit" class="button button-danger">Archivar producto</button></div></form></section></main></body></html>

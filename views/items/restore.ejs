<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Boxing Inventory</title><link rel="stylesheet" href="/styles.css"></head>
<body><header class="main-header"><div class="container header-content"><a href="/" class="logo">Boxing Inventory</a><nav aria-label="Navegación principal"><a href="/items">Productos activos</a><a href="/items/archived">Productos archivados</a></nav></div></header>
<main class="container form-page"><a href="/items/<%= item.id %>/archived" class="back-link">← Regresar al producto archivado</a><section class="delete-container"><div><p class="eyebrow">Confirmación</p><h1>Restaurar producto</h1><p class="form-description">El producto volverá al inventario activo sin cambiar su SKU.</p></div><article class="delete-card"><h2><%= item.name %></h2><p>SKU: <strong><%= item.sku %></strong></p><p>Motivo original: <%= item.archive_reason %></p></article><form action="/items/<%= item.id %>/restore" method="POST" class="form-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><a href="/items/<%= item.id %>/archived" class="button button-secondary">Cancelar</a><button type="submit" class="button">Restaurar producto</button></form></section></main></body></html>

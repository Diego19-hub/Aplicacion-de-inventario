<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body><main class="container form-page"><a href="/items/<%= item.id %>/movements" class="back-link">← Regresar al historial</a><section class="form-container"><h1>Registrar movimiento</h1><p>Producto: <strong><%= item.name %></strong>. Stock total: <strong><%= item.stock %></strong>.</p><% if(errors.length){ %><div class="error-summary"><ul><% errors.forEach(error=>{ %><li><%= error.msg %></li><% }) %></ul></div><% } %><form method="POST" class="inventory-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-group"><label for="locationId">Ubicación</label><select id="locationId" name="locationId" required><% locations.forEach(location=>{ %><option value="<%= location.id %>" <%= String(formData.locationId)===String(location.id)?'selected':'' %>><%= location.name %> (<%= location.code %>)</option><% }) %></select></div><div class="form-group"><label for="movementType">Tipo</label><select id="movementType" name="movementType"><option value="entry">Entrada — suma existencias</option><option value="exit">Salida — resta existencias</option><option value="adjustment">Ajuste — establece la existencia física final</option></select></div><div class="form-group"><label for="quantity">Cantidad</label><input id="quantity" name="quantity" type="number" min="0" step="1" value="<%= formData.quantity %>" required></div><div class="form-group"><label for="reason">Motivo</label><textarea id="reason" name="reason" minlength="5" maxlength="500" required><%= formData.reason %></textarea></div><div class="form-group"><label for="reference">Referencia opcional</label><input id="reference" name="reference" maxlength="120" value="<%= formData.reference %>"></div><button class="button">Registrar movimiento</button></form></section></main></body></html>

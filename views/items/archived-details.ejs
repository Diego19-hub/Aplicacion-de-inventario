<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Boxing Inventory</title><link rel="stylesheet" href="/styles.css"></head>
<body><header class="main-header"><div class="container header-content"><a href="/" class="logo">Boxing Inventory</a><nav aria-label="Navegación principal"><a href="/items">Productos activos</a><a href="/items/archived">Productos archivados</a></nav></div></header>
<main class="container page-content"><a href="/items/archived" class="back-link">← Regresar a archivados</a><section class="item-details"><div class="item-details-main"><p class="eyebrow">Producto archivado</p><h1><%= item.name %></h1><p class="item-description"><%= item.description %></p><p>SKU: <strong><%= item.sku %></strong></p><p>Categoría: <%= item.category_name %></p></div><aside class="item-details-panel"><dl><div><dt>Archivado</dt><dd><%= new Date(item.archived_at).toLocaleString("es-MX") %></dd></div><div><dt>Por</dt><dd><%= item.archived_by_username %></dd></div><div><dt>Motivo</dt><dd><%= item.archive_reason %></dd></div></dl><div class="details-actions"><a href="/items/<%= item.id %>/restore" class="button">Restaurar</a></div></aside></section></main></body></html>

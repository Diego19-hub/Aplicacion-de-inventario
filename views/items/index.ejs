<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Boxing Inventory</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="main-header">
    <div class="container header-content">
      <a href="/" class="logo">Boxing Inventory</a>
      <nav aria-label="Navegación principal">
        <a href="/">Inicio</a>
        <a href="/categories">Categorías</a>
        <a href="/items">Productos</a>
        <span class="current-user"><%= currentBusiness.name %></span>
        <a href="/businesses/select">Cambiar negocio</a>
      </nav>
    </div>
  </header>

  <main class="container page-content">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Inventario</p>
        <h1>Productos</h1>
        <p>Consulta todos los productos disponibles en la tienda.</p>
      </div>
      <% if (canManageInventory) { %>
        <a href="/items/new" class="button">Crear producto</a>
      <% } %>
      <% if (canDeleteInventory) { %>
        <a href="/items/archived" class="button button-secondary">Productos archivados</a>
      <% } %>
    </div>

    <form action="/items" method="GET" class="item-filters">
      <div class="form-group">
        <label for="q">Buscar productos</label>
        <input
          id="q"
          name="q"
          type="search"
          value="<%= filters.query %>"
          placeholder="Buscar por nombre o SKU"
        >
      </div>

      <div class="form-group">
        <label for="category">Categoría</label>
        <select id="category" name="category">
          <option value="">Todas las categorías</option>
          <% categories.forEach((category) => { %>
            <option value="<%= category.id %>" <%= filters.categoryId === category.id ? "selected" : "" %>>
              <%= category.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="filter-actions">
        <button type="submit" class="button">Buscar</button>
        <a href="/items" class="button button-secondary">Limpiar filtros</a>
      </div>
    </form>

    <p class="results-count" aria-live="polite">
      <%= totalItems %> <%= totalItems === 1 ? "producto encontrado" : "productos encontrados" %>
    </p>

    <% if (items.length === 0) { %>
      <p class="empty-message">
        <%= hasFilters
          ? "No se encontraron productos con los filtros seleccionados."
          : "El inventario todavía no contiene productos." %>
      </p>
    <% } else { %>
      <div class="items-grid">
        <% items.forEach((item) => { %>
          <article class="item-card">
            <div>
              <span class="brand"><%= item.brand %></span>
              <span class="badge">SKU: <%= item.sku %></span>
              <h2><a href="/items/<%= item.id %>"><%= item.name %></a></h2>
              <p><%= item.description %></p>
              <a href="/categories/<%= item.category_id %>" class="category-link">
                <%= item.category_name %>
              </a>
            </div>
            <div class="item-information">
              <strong><%= Number(item.price).toLocaleString("es-MX", {
                style: "currency", currency: "MXN"
              }) %></strong>
              <% if (item.stock === 0) { %>
                <span class="stock stock-empty">Sin existencias</span>
              <% } else { %>
                <span class="stock"><%= item.stock %> disponibles</span>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>

    <% if (totalItems > 0 && pagination.totalPages > 1) { %>
      <nav class="pagination" aria-label="Paginación de productos">
        <% if (pagination.page > 1) { %>
          <a class="button button-secondary" href="<%= itemsUrl({ ...filters, page: pagination.page - 1 }) %>">Anterior</a>
        <% } %>

        <% pagination.pages.forEach((pageNumber) => { %>
          <% if (pageNumber === null) { %>
            <span class="pagination-ellipsis" aria-hidden="true">…</span>
          <% } else if (pageNumber === pagination.page) { %>
            <span class="button pagination-current" aria-current="page"><%= pageNumber %></span>
          <% } else { %>
            <a class="button button-secondary" href="<%= itemsUrl({ ...filters, page: pageNumber }) %>"><%= pageNumber %></a>
          <% } %>
        <% }) %>

        <% if (pagination.page < pagination.totalPages) { %>
          <a class="button button-secondary" href="<%= itemsUrl({ ...filters, page: pagination.page + 1 }) %>">Siguiente</a>
        <% } %>
      </nav>
    <% } %>
  </main>
</body>
</html>

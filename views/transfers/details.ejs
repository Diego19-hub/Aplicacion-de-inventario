<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body><main class="container page-content"><a href="/transfers" class="back-link">← Transferencias</a><h1><%= transfer.item_name %> · <%= transfer.sku %></h1><dl><dt>Origen</dt><dd><%= transfer.from_name %> (<%= transfer.from_code %>)</dd><dt>Destino</dt><dd><%= transfer.to_name %> (<%= transfer.to_code %>)</dd><dt>Cantidad</dt><dd><%= transfer.quantity %></dd><dt>Usuario</dt><dd><%= transfer.username %></dd><dt>Motivo</dt><dd><%= transfer.reason %></dd><dt>Referencia</dt><dd><%= transfer.reference || '—' %></dd></dl><table class="admin-table"><thead><tr><th>Tipo</th><th>Anterior</th><th>Resultado</th></tr></thead><tbody><% transfer.movements.forEach(m=>{ %><tr><td><%= m.movement_type==='transfer_out'?'Transferencia — salida':'Transferencia — entrada' %></td><td><%= m.previous_stock %></td><td><%= m.resulting_stock %></td></tr><% }) %></tbody></table></main></body></html>

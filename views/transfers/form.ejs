<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body><main class="container form-page"><a href="/transfers" class="back-link">← Transferencias</a><h1>Nueva transferencia</h1><p>La transferencia no cambia el stock total del producto.</p><% if(errors.length){ %><ul><% errors.forEach(e=>{ %><li><%= e.msg %></li><% }) %></ul><% } %><form method="POST" class="inventory-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Producto<select name="itemId"><% items.forEach(i=>{ %><option value="<%= i.id %>" <%= String(formData.itemId)===String(i.id)?'selected':'' %>><%= i.name %> · <%= i.sku %></option><% }) %></select></label><label>Origen<select name="fromLocationId"><% locations.forEach(l=>{ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label><label>Destino<select name="toLocationId"><% locations.forEach(l=>{ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label><label>Cantidad<input name="quantity" type="number" min="1" value="<%= formData.quantity %>"></label><label>Motivo<textarea name="reason"><%= formData.reason %></textarea></label><label>Referencia<input name="reference" value="<%= formData.reference %>"></label><button class="button">Transferir</button></form></main></body></html>

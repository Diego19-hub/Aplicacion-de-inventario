<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container form-page">
    <a href="/transfers" class="back-link">← Transferencias</a>
    <h1>Nueva transferencia</h1>
    <p id="transfer-help">La transferencia no cambia el stock total del producto.</p>
    <% if (errors.length) { %><div class="error-summary" role="alert"><ul><% errors.forEach((error) => { %><li><%= error.msg %></li><% }) %></ul></div><% } %>
    <% const errorFor = (field) => errors.find((error) => error.path === field); const itemError=errorFor('itemId'),fromError=errorFor('fromLocationId'),toError=errorFor('toLocationId'),quantityError=errorFor('quantity'),reasonError=errorFor('reason'),referenceError=errorFor('reference'); %>
    <form method="POST" class="inventory-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group"><label for="itemId">Producto</label><select id="itemId" name="itemId" <%= itemError ? 'aria-invalid="true" aria-describedby="itemId-error"' : '' %>><% items.forEach((item) => { %><option value="<%= item.id %>" <%= String(formData.itemId) === String(item.id) ? 'selected' : '' %>><%= item.name %> · <%= item.sku %></option><% }) %></select><% if(itemError){ %><p id="itemId-error" class="field-error"><%= itemError.msg %></p><% } %></div>
      <div class="form-group"><label for="fromLocationId">Origen</label><select id="fromLocationId" name="fromLocationId" <%= fromError ? 'aria-invalid="true" aria-describedby="fromLocationId-error"' : '' %>><% locations.forEach((location) => { %><option value="<%= location.id %>" <%= String(formData.fromLocationId) === String(location.id) ? 'selected' : '' %>><%= location.name %></option><% }) %></select><% if(fromError){ %><p id="fromLocationId-error" class="field-error"><%= fromError.msg %></p><% } %></div>
      <div class="form-group"><label for="toLocationId">Destino</label><select id="toLocationId" name="toLocationId" <%= toError ? 'aria-invalid="true" aria-describedby="toLocationId-error"' : '' %>><% locations.forEach((location) => { %><option value="<%= location.id %>" <%= String(formData.toLocationId) === String(location.id) ? 'selected' : '' %>><%= location.name %></option><% }) %></select><% if(toError){ %><p id="toLocationId-error" class="field-error"><%= toError.msg %></p><% } %></div>
      <div class="form-group"><label for="quantity">Cantidad</label><input id="quantity" name="quantity" type="number" min="1" value="<%= formData.quantity %>" aria-describedby="transfer-help<%= quantityError ? ' quantity-error' : '' %>" <%= quantityError ? 'aria-invalid="true"' : '' %>><% if(quantityError){ %><p id="quantity-error" class="field-error"><%= quantityError.msg %></p><% } %></div>
      <div class="form-group"><label for="reason">Motivo</label><textarea id="reason" name="reason" <%= reasonError ? 'aria-invalid="true" aria-describedby="reason-error"' : '' %>><%= formData.reason %></textarea><% if(reasonError){ %><p id="reason-error" class="field-error"><%= reasonError.msg %></p><% } %></div>
      <div class="form-group"><label for="reference">Referencia (opcional)</label><input id="reference" name="reference" value="<%= formData.reference %>" <%= referenceError ? 'aria-invalid="true" aria-describedby="reference-error"' : '' %>><% if(referenceError){ %><p id="reference-error" class="field-error"><%= referenceError.msg %></p><% } %></div>
      <button class="button">Transferir</button>
    </form>
  </main>
</body>
</html>

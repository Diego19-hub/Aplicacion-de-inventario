<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container page-content">
    <a href="/" class="back-link">← Inicio</a>

    <div class="section-heading">
      <h1>Transferencias</h1>
      <% if (currentMembership?.role !== "viewer") { %>
        <a class="button" href="/transfers/new">Nueva transferencia</a>
      <% } %>
    </div>

    <form method="GET">
      <div class="form-group">
        <label for="transfer-search">Buscar transferencia</label>
        <input
          id="transfer-search"
          name="q"
          value="<%= q %>"
          placeholder="Producto, SKU o referencia"
        >
      </div>

      <div class="form-group">
        <label for="transfer-location">Ubicación</label>
        <select id="transfer-location" name="locationId">
          <option value="">Todas las ubicaciones</option>
          <% locations.forEach((location) => { %>
            <option
              value="<%= location.id %>"
              <%= locationId === location.id ? "selected" : "" %>
            >
              <%= location.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-actions">
        <button class="button button-secondary">Filtrar</button>
        <a class="button button-secondary" href="/transfers">Limpiar</a>
      </div>
    </form>

    <p><%= count %> transferencias</p>

    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Producto</th>
            <th>Origen</th>
            <th>Destino</th>
            <th>Cantidad</th>
            <th>Usuario</th>
            <th>Fecha</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((transfer) => { %>
            <tr>
              <td>
                <a href="/transfers/<%= transfer.id %>">
                  <%= transfer.item_name %> · <%= transfer.sku %>
                </a>
              </td>
              <td><%= transfer.from_name %></td>
              <td><%= transfer.to_name %></td>
              <td><%= transfer.quantity %></td>
              <td><%= transfer.username %></td>
              <td><%= new Date(transfer.created_at).toLocaleString("es-MX") %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>

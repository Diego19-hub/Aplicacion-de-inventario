<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body><main class="container page-content"><a href="/" class="back-link">← Inicio</a><div class="section-heading"><h1>Transferencias</h1><% if(currentMembership?.role!=='viewer'){ %><a class="button" href="/transfers/new">Nueva transferencia</a><% } %></div><form method="GET"><input name="q" value="<%= q %>" placeholder="Producto, SKU o referencia"><select name="locationId"><option value="">Todas las ubicaciones</option><% locations.forEach(l=>{ %><option value="<%= l.id %>" <%= locationId===l.id?'selected':'' %>><%= l.name %></option><% }) %></select><button class="button button-secondary">Filtrar</button></form><p><%= count %> transferencias</p><table class="admin-table"><thead><tr><th>Producto</th><th>Origen</th><th>Destino</th><th>Cantidad</th><th>Usuario</th><th>Fecha</th></tr></thead><tbody><% rows.forEach(t=>{ %><tr><td><a href="/transfers/<%= t.id %>"><%= t.item_name %> · <%= t.sku %></a></td><td><%= t.from_name %></td><td><%= t.to_name %></td><td><%= t.quantity %></td><td><%= t.username %></td><td><%= new Date(t.created_at).toLocaleString('es-MX') %></td></tr><% }) %></tbody></table></main></body></html>

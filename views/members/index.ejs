<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Boxing Inventory</title><link rel="stylesheet" href="/styles.css"></head>
<body><header class="main-header"><div class="container header-content"><a href="/" class="logo">Boxing Inventory</a><nav aria-label="Navegación"><a href="/">Inicio</a><a href="/categories">Categorías</a><a href="/items">Productos</a><a href="/businesses/select">Cambiar negocio</a></nav></div></header>
<main class="container page-content"><a href="/" class="back-link">← Regresar al inventario</a><p class="eyebrow">Negocio activo: <%= currentBusiness.name %></p><h1>Miembros e invitaciones</h1>
<% if (invitationLink) { %><section class="form-container"><h2>Invitación creada</h2><p>Comparte este enlace con <%= createdInvitation.email_normalized %>. Vence el <%= new Date(createdInvitation.expires_at).toLocaleDateString("es-MX") %>.</p><label for="invitationLink">Enlace de invitación</label><input id="invitationLink" type="text" value="<%= invitationLink %>" readonly onclick="this.select()"></section><% } %>
<section class="form-container"><h2>Invitar miembro</h2><p class="form-description">Solo puedes invitar como manager o viewer. Una nueva invitación revoca la pendiente anterior para ese correo.</p>
<% if (errors.length) { %><div class="error-summary" role="alert"><ul><% errors.forEach((error) => { %><li><%= error.msg %></li><% }) %></ul></div><% } %>
<form action="/members/invitations" method="POST" class="inventory-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-group"><label for="email">Correo</label><input id="email" name="email" type="email" maxlength="254" value="<%= formData.email %>" required></div><div class="form-group"><label for="role">Rol</label><select id="role" name="role"><option value="viewer" <%= formData.role === "viewer" ? "selected" : "" %>>Viewer</option><option value="manager" <%= formData.role === "manager" ? "selected" : "" %>>Manager</option></select></div><button class="button" type="submit">Crear invitación</button></form></section>
<section class="categories-section"><h2>Miembros</h2><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><% members.forEach((member) => { %><tr><td><%= member.username %></td><td><%= member.email %></td><td><%= member.role %></td><td><%= member.status %></td><td><% if (member.role === "owner") { %><span>Propietario</span><% } else { %><form action="/members/<%= member.id %>/role" method="POST" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="role"><option value="manager" <%= member.role === "manager" ? "selected" : "" %>>Manager</option><option value="viewer" <%= member.role === "viewer" ? "selected" : "" %>>Viewer</option></select><button type="submit">Cambiar rol</button></form><% if (member.status === "active") { %><form action="/members/<%= member.id %>/suspend" method="POST" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Suspender</button></form><% } else if (member.status === "suspended") { %><form action="/members/<%= member.id %>/reactivate" method="POST" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Reactivar</button></form><% } %><% if (member.status !== "removed") { %><form action="/members/<%= member.id %>/remove" method="POST" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Retirar</button></form><% } %><% } %></td></tr><% }) %></tbody></table></div></section>
<section class="categories-section"><h2>Invitaciones</h2><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Correo</th><th>Rol</th><th>Estado</th><th>Vence</th><th>Acción</th></tr></thead><tbody><% invitations.forEach((invitation) => { %><tr><td><%= invitation.email_normalized %></td><td><%= invitation.offered_role %></td><td><%= invitation.status %></td><td><%= new Date(invitation.expires_at).toLocaleDateString("es-MX") %></td><td><% if (invitation.status === "pending") { %><form action="/members/invitations/<%= invitation.id %>/revoke" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Revocar</button></form><% } %></td></tr><% }) %></tbody></table></div></section></main></body></html>

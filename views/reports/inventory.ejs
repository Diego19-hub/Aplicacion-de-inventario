<!doctype html><html lang="es"><head><meta charset="utf-8"><title><%= title %></title></head><body><main><a href="/reports">← Reportes</a><h1>Existencias</h1><form method="GET"><input name="q" value="<%= filters.q %>"><select name="category"><option value="">Categorías</option><% categories.forEach(x=>{%><option value="<%=x.id%>" <%=filters.categoryId===x.id?'selected':''%>><%=x.name%></option><%})%></select><select name="location"><option value="">Ubicaciones</option><% locations.forEach(x=>{%><option value="<%=x.id%>" <%=filters.locationId===x.id?'selected':''%>><%=x.name%></option><%})%></select><select name="productStatus"><option value="active">Activos</option><option value="archived">Archivados</option><option value="all">Todos</option></select><select name="stockRows"><option value="positive">Con stock</option><option value="all">Todos</option></select><button>Filtrar</button><a href="/reports/inventory">Limpiar</a></form><p><%=count%> resultados</p><table><thead><tr><th>Producto</th><th>SKU</th><th>Categoría</th><th>Ubicación</th><th>Código</th><th>Tipo</th><th>Estado ubicación</th><th>Stock local</th><th>Total</th><th>Estado producto</th></tr></thead><tbody><% rows.forEach(r=>{%><tr><td><%=r.name%></td><td><%=r.sku%></td><td><%=r.category_name%></td><td><%=r.location_name%></td><td><%=r.code%></td><td><%=r.location_type%></td><td><%=r.location_status%></td><td><%=r.local_stock%></td><td><%=r.total_stock%></td><td><%=r.product_status%></td></tr><%})%></tbody></table></main></body></html>

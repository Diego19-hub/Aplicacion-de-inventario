<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body><main class="container page-content"><a href="/locations" class="back-link">← Ubicaciones</a><h1><%= location.name %></h1><dl><dt>Código</dt><dd><%= location.code %></dd><dt>Tipo</dt><dd><%= location.location_type %></dd><dt>Estado</dt><dd><%= location.status %></dd><dt>Principal</dt><dd><%= location.is_default?'Sí':'No' %></dd><dt>Stock total</dt><dd><%= location.total_stock %></dd></dl><% if(currentMembership?.role==='owner'){ %><a class="button" href="/locations/<%= location.id %>/edit">Editar</a><% if(location.status==='active'){ %><a class="button button-secondary" href="/locations/<%= location.id %>/deactivate">Desactivar</a><% }else{ %><a class="button button-secondary" href="/locations/<%= location.id %>/reactivate">Reactivar</a><% } %><% if(!location.is_default&&location.status==='active'){ %><a class="button" href="/locations/<%= location.id %>/make-default">Convertir en principal</a><% } %><% } %></main></body></html>

<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body><main class="container page-content"><a href="/" class="back-link">← Inicio</a><div class="section-heading"><h1>Ubicaciones</h1><% if(currentMembership?.role==='owner'){ %><a class="button" href="/locations/new">Nueva ubicación</a><% } %></div><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Nombre</th><th>Código</th><th>Tipo</th><th>Estado</th><th>Principal</th><th>Stock</th></tr></thead><tbody><% locations.forEach(l=>{ %><tr><td><a href="/locations/<%= l.id %>"><%= l.name %></a></td><td><%= l.code %></td><td><%= l.location_type %></td><td><%= l.status %></td><td><%= l.is_default?'Sí':'No' %></td><td><%= l.total_stock %></td></tr><% }) %></tbody></table></div></main></body></html>

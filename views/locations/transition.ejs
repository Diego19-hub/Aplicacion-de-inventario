<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body><main class="container form-page"><a href="/locations/<%= location.id %>" class="back-link">← Regresar</a><h1><%= action==='make-default'?'Convertir en principal':action==='deactivate'?'Desactivar ubicación':'Reactivar ubicación' %></h1><p><%= location.name %></p><% if (typeof error !== "undefined" && error) { %><p class="error-summary"><%= error %></p><% } %><form method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button">Confirmar</button></form></main></body></html>

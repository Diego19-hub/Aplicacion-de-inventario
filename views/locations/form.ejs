<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head><body><main class="container form-page"><a href="/locations" class="back-link">← Ubicaciones</a><h1><%= title %></h1><% if(errors.length){ %><ul><% errors.forEach(e=>{ %><li><%= e.msg %></li><% }) %></ul><% } %><form method="POST" class="inventory-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nombre<input name="name" required minlength="2" maxlength="120" value="<%= location.name %>"></label><label>Código<input name="code" required minlength="2" maxlength="30" value="<%= location.code %>"></label><label>Tipo<select name="locationType"><option value="branch" <%= location.locationType==='branch'?'selected':'' %>>Sucursal</option><option value="warehouse" <%= location.locationType==='warehouse'?'selected':'' %>>Almacén</option></select></label><label>Dirección<input name="address" maxlength="500" value="<%= location.address %>"></label><label>Teléfono<input name="phone" maxlength="40" value="<%= location.phone %>"></label><label>Notas<textarea name="notes" maxlength="1000"><%= location.notes %></textarea></label><button class="button">Guardar</button></form></main></body></html>

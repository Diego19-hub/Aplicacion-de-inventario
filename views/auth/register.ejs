<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> | Boxing Inventory</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <header class="main-header">
    <div class="container header-content">
      <a href="/" class="logo">Boxing Inventory</a>

      <nav aria-label="Navegación principal">
        <a href="/">Inicio</a>
        <a href="/categories">Categorías</a>
        <a href="/items">Productos</a>
        <a href="/auth/register">Crear cuenta</a>
      </nav>
    </div>
  </header>

  <main class="container auth-page">
    <section class="auth-container">
      <div>
        <p class="eyebrow">Nueva cuenta</p>
        <h1>Crear cuenta</h1>

        <p class="form-description">
          Regístrate para acceder a las funciones del inventario.
        </p>
      </div>

      <% if (errors.length > 0) { %>
        <div class="error-summary" role="alert">
          <strong>No se pudo crear la cuenta:</strong>

          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form
        action="/auth/register"
        method="POST"
        class="inventory-form"
      >
        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >
        <div class="form-group">
          <label for="username">Nombre de usuario</label>

          <input
            type="text"
            id="username"
            name="username"
            value="<%= formData.username %>"
            minlength="3"
            maxlength="30"
            autocomplete="username"
            required
          >

          <small>Letras, números y guion bajo.</small>
        </div>

        <div class="form-group">
          <label for="email">Correo electrónico</label>

          <input
            type="email"
            id="email"
            name="email"
            value="<%= formData.email %>"
            maxlength="254"
            autocomplete="email"
            required
          >
        </div>

        <div class="form-group">
          <label for="password">Contraseña</label>

          <input
            type="password"
            id="password"
            name="password"
            minlength="8"
            maxlength="64"
            autocomplete="new-password"
            required
          >

          <small>Utiliza al menos ocho caracteres.</small>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirmar contraseña</label>

          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            minlength="8"
            maxlength="64"
            autocomplete="new-password"
            required
          >
        </div>

        <button type="submit" class="button auth-button">
          Crear cuenta
        </button>
      </form>

      <p class="auth-alternative">
        ¿Ya tienes una cuenta?
        <a href="/auth/login">Inicia sesión</a>
      </p>
    </section>
  </main>
</body>
</html>

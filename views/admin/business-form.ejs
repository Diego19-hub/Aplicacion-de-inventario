<!DOCTYPE html>
<html lang="es">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Boxing Inventory</title><link rel="stylesheet" href="/styles.css"></head>
<body>
  <header class="main-header"><div class="container header-content"><a href="/admin" class="logo">Boxing Inventory</a><nav aria-label="Administración"><a href="/admin">Panel</a><a href="/admin/businesses">Negocios</a></nav></div></header>
  <main class="container form-page">
    <a href="/admin/businesses" class="back-link">← Regresar a negocios</a>
    <section class="form-container">
      <div><p class="eyebrow">Superadministración</p><h1><%= title %></h1><p class="form-description">Los campos con “opcional” pueden dejarse vacíos.</p></div>
      <% const errorFor = (path) => errors.find((error) => error.path === path); %>
      <% if (errors.length > 0) { %><div class="error-summary" role="alert"><strong>Revisa la información del formulario:</strong><ul><% errors.forEach((error) => { %><li><%= error.msg %></li><% }) %></ul></div><% } %>
      <form action="<%= formAction %>" method="POST" class="inventory-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group"><label for="name">Nombre comercial</label><input id="name" name="name" value="<%= formData.name %>" placeholder="Ej. Boxing Centro" required maxlength="120"><% if (errorFor("name")) { %><small class="field-error"><%= errorFor("name").msg %></small><% } %></div>
        <div class="form-group"><label for="slug">Slug</label><input id="slug" name="slug" value="<%= formData.slug %>" placeholder="ej. boxing-centro" required maxlength="100" pattern="[a-z0-9]+(?:-[a-z0-9]+)*"><% if (errorFor("slug")) { %><small class="field-error"><%= errorFor("slug").msg %></small><% } %></div>
        <% if (owner === null) { %><div class="form-group"><label for="ownerEmail">Correo del propietario</label><input id="ownerEmail" type="email" name="ownerEmail" value="<%= formData.ownerEmail %>" placeholder="propietario@ejemplo.com" required><% if (errorFor("ownerEmail")) { %><small class="field-error"><%= errorFor("ownerEmail").msg %></small><% } %></div><% } else { %><div class="warning-message"><strong>Propietario actual</strong><p><%= owner.username ?? "Sin owner activo" %><%= owner.email ? ` (${owner.email})` : "" %>. No se puede cambiar desde este formulario.</p></div><% } %>
        <div class="form-group"><label for="legalName">Razón social (opcional)</label><input id="legalName" name="legalName" value="<%= formData.legalName %>" placeholder="Razón social registrada" maxlength="255"><% if (errorFor("legalName")) { %><small class="field-error"><%= errorFor("legalName").msg %></small><% } %></div>
        <div class="form-group"><label for="taxId">RFC o identificación fiscal (opcional)</label><input id="taxId" name="taxId" value="<%= formData.taxId %>" placeholder="ABC010203XYZ" maxlength="100"><% if (errorFor("taxId")) { %><small class="field-error"><%= errorFor("taxId").msg %></small><% } %></div>
        <div class="form-row"><div class="form-group"><label for="currency">Moneda</label><input id="currency" name="currency" value="<%= formData.currency %>" placeholder="MXN" maxlength="3" pattern="[A-Z]{3}" required><% if (errorFor("currency")) { %><small class="field-error"><%= errorFor("currency").msg %></small><% } %></div><div class="form-group"><label for="timezone">Zona horaria</label><input id="timezone" name="timezone" value="<%= formData.timezone %>" placeholder="America/Mexico_City" required><% if (errorFor("timezone")) { %><small class="field-error"><%= errorFor("timezone").msg %></small><% } %></div></div>
        <div class="form-actions"><a href="/admin/businesses" class="button button-secondary">Cancelar</a><button type="submit" class="button">Guardar negocio</button></div>
      </form>
    </section>
  </main>
</body>
</html>
